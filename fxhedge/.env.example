# Copy to .env.local and fill in. NEVER commit .env.local.
# Keys live at: supabase.com/dashboard -> your project -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only: guardrailed Islamic finance assistant (dev1/chatbot task)
# Preferred provider: Groq (console.groq.com/keys)
GROQ_API_KEY=
# Optional — overrides the default model without a code change
# GROQ_MODEL=openai/gpt-oss-20b

# Optional fallback providers
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
